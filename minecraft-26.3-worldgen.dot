digraph Minecraft_26_3_Worldgen {
  graph [
    label="Minecraft Java Edition 26.3: seed to playable, rendered world\nComprehensive server world-generation and client-delivery flow",
    labelloc=t,
    fontsize=24,
    fontname="Helvetica Bold",
    rankdir=TB,
    compound=true,
    newrank=true,
    splines=polyline,
    nodesep=0.35,
    ranksep=0.60,
    pad=0.25,
    bgcolor="#f8fafc"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#334155",
    fillcolor="#ffffff",
    margin="0.12,0.08"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#475569",
    arrowsize=0.75
  ];

  // Color key:
  // blue = bootstrap/configuration, amber = server scheduling/statuses,
  // green = terrain algorithms, violet = runtime/network/client,
  // gray = persistence/alternative path, red = decisions/failures.

  subgraph cluster_inputs {
    label="1. Seed, options, packs, and registries";
    color="#93c5fd";
    fillcolor="#eff6ff";
    style="rounded,filled";

    entry [label="START\nCreate/open singleplayer world or launch dedicated server\nbootstrap built-in registries; open/lock world storage", fillcolor="#dbeafe"];
    seed_source [label="New-world seed input\nCreate World seed field or server.properties level-seed", fillcolor="#dbeafe"];
    seed_parse [label="WorldOptions.parseSeed(text): trim first\nempty -> OptionalLong.empty (caller supplies random long)\nvalid long -> parsed value; otherwise String.hashCode()", fillcolor="#dbeafe"];
    world_options [label="WorldOptions\nseed + generateStructures + generateBonusChest", fillcolor="#dbeafe"];

    pack_selection [label="Select vanilla + enabled server data packs\nPackRepository / WorldDataConfiguration", fillcolor="#dbeafe"];
    resource_manager [label="WorldLoader.PackConfig.createResourceManager()\nMultiPackResourceManager", fillcolor="#dbeafe"];
    static_registries [label="STATIC registry layer\nBuiltInRegistries + static tags", fillcolor="#dbeafe"];
    world_registries [label="Load WORLD_REGISTRIES from data packs\nbiomes, carvers, features, structures, structure sets,\nnoise, density functions, material rules, noise settings, presets", fillcolor="#dbeafe"];
    dimension_registries [label="Load DIMENSION_REGISTRIES\nLEVEL_STEM entries", fillcolor="#dbeafe"];
    reloadable_resources [label="ReloadableServerResources.loadResources()\nrecipes, loot, tags, commands, advancements, functions", fillcolor="#dbeafe"];

    world_exists [shape=diamond, label="Saved world exists?", fillcolor="#fee2e2"];
    load_saved_settings [label="Read level.dat + data/minecraft/world_gen_settings.dat\nfile/data fixes + WorldGenSettings.CODEC\nrecover saved seed/options/dimensions", fillcolor="#e2e8f0"];
    choose_preset [label="Choose/create WorldPreset\nnormal, large biomes, amplified, flat, debug, custom", fillcolor="#dbeafe"];
    build_dimensions [label="Build WorldDimensions\nLevelStem = DimensionType + ChunkGenerator", fillcolor="#dbeafe"];
    bake_dimensions [label="WorldDimensions.bake(current data-pack stems)\nmerge/freeze final LEVEL_STEM registry\ndatapack entry wins for duplicate key", fillcolor="#dbeafe"];
    worldgen_settings [label="WorldGenSettings\nWorldOptions + baked WorldDimensions", fillcolor="#dbeafe"];
    world_stem [label="WorldStem\nresources + layered registries + world data/settings", fillcolor="#dbeafe"];

    entry -> seed_source [label="new world"];
    entry -> pack_selection [label="saved pack configuration or new selection"];
    seed_source -> seed_parse -> world_options;
    pack_selection -> resource_manager -> static_registries -> world_registries -> dimension_registries;
    dimension_registries -> world_exists;
    world_exists -> load_saved_settings [label="yes"];
    world_exists -> choose_preset [label="no"];
    world_options -> choose_preset;
    choose_preset -> build_dimensions;
    load_saved_settings -> bake_dimensions;
    build_dimensions -> bake_dimensions;
    bake_dimensions -> worldgen_settings;
    world_options -> worldgen_settings [label="new world"];
    worldgen_settings -> reloadable_resources -> world_stem;
  }

  subgraph cluster_server_init {
    label="2. Server and per-dimension generator initialization";
    color="#93c5fd";
    fillcolor="#eff6ff";
    style="rounded,filled";

    server_spin [label="MinecraftServer.spin()\nDedicatedServer or IntegratedServer", fillcolor="#dbeafe"];
    server_load [label="MinecraftServer.loadLevel()\ncreateLevels -> prepareLevels", fillcolor="#dbeafe"];
    level_loop [label="Construct Overworld first; initialize global spawn\nthen construct remaining LevelStems\nNether, End, custom dimensions", fillcolor="#dbeafe"];
    server_level [label="Construct ServerLevel\nall dimensions share saved world seed", fillcolor="#dbeafe"];
    generator_dispatch [shape=diamond, label="ChunkGenerator type?", fillcolor="#fee2e2"];
    noise_generator [label="NoiseBasedChunkGenerator\nBiomeSource + NoiseGeneratorSettings", fillcolor="#dcfce7"];
    flat_generator [label="FlatLevelSource\nconfigured layers + fixed biome", fillcolor="#e2e8f0"];
    debug_generator [label="DebugLevelSource\nbarrier/display grid during FEATURES", fillcolor="#e2e8f0"];
    server_chunk_cache [label="ServerChunkCache", fillcolor="#dbeafe"];
    chunk_map_init [label="ChunkMap\nregion storage + task dispatchers + light engine + distance manager", fillcolor="#dbeafe"];
    random_state [label="RandomState.create(noise registry, seed, settings)\nselect Xoroshiro or legacy RNG\ninitialize lazy density compiler + keyed noises + MaterialSystem", fillcolor="#dcfce7"];
    dummy_random_state [label="Dummy RandomState for flat/debug\nstone + sea level 63 + empty NoiseRouter", fillcolor="#e2e8f0"];
    structure_state [label="ChunkGenerator.createState()\nChunkGeneratorStructureState\nfilter structure sets by possible biomes\nprecompute concentric-ring positions", fillcolor="#dcfce7"];
    biome_resolver [label="BiomeSource.createUncachedResolver(RandomState)\nper-dimension biome resolver", fillcolor="#dcfce7"];

    world_stem -> server_spin -> server_load -> level_loop -> server_level -> generator_dispatch;
    generator_dispatch -> noise_generator [label="noise"];
    generator_dispatch -> flat_generator [label="flat"];
    generator_dispatch -> debug_generator [label="debug"];
    noise_generator -> server_chunk_cache;
    flat_generator -> server_chunk_cache;
    debug_generator -> server_chunk_cache;
    server_chunk_cache -> chunk_map_init;
    noise_generator -> random_state;
    chunk_map_init -> random_state [label="per dimension"];
    chunk_map_init -> dummy_random_state [label="flat/debug"];
    random_state -> structure_state;
    dummy_random_state -> structure_state;
    structure_state -> biome_resolver;
  }

  subgraph cluster_spawn_init {
    label="3. New-world initial spawn";
    color="#fbbf24";
    fillcolor="#fffbeb";
    style="rounded,filled";

    initialized_world [shape=diamond, label="Overworld only: level data already initialized?", fillcolor="#fee2e2"];
    debug_spawn_check [shape=diamond, label="Debug world / developer spawn override?", fillcolor="#fee2e2"];
    debug_spawn [label="Debug world: fixed spawn (0,80,0)\nset spectator, peaceful, fixed weather/time\n(developer override has its own fixed position)", fillcolor="#e2e8f0"];
    skip_spawn_init [label="Keep saved spawn\n(no initial spawn search or bonus chest)", fillcolor="#e2e8f0"];
    spawn_origin [label="ChunkGenerator.getOrigin(RandomState)\nnoise generator: NoiseSpawnFinder searches spawn-target density fitness", fillcolor="#fef3c7"];
    spawn_height [label="Get spawn height\nfall back to WORLD_SURFACE heightmap when needed", fillcolor="#fef3c7"];
    spawn_spiral [label="Spiral up to 11 x 11 candidate chunks\nPlayerSpawnFinder.getSpawnPosInChunk()", fillcolor="#fef3c7"];
    spawn_full_request [label="Candidate checks request ChunkStatus.FULL\nThis triggers the chunk pipeline below", fillcolor="#fef3c7"];
    spawn_candidate [shape=diamond, label="Valid spawn in candidate chunk?", fillcolor="#fee2e2"];
    spawn_more [shape=diamond, label="More spiral candidates?", fillcolor="#fee2e2"];
    final_spawn [label="Use first valid position; if none found, retain\ninitial origin-chunk center + spawn-height fallback", fillcolor="#fef3c7"];
    bonus_chest_check [shape=diamond, label="Bonus chest enabled and normal world?", fillcolor="#fee2e2"];
    bonus_chest [label="BonusChestFeature.place()\nchest + loot table + surrounding torches", fillcolor="#fef3c7"];
    finish_levels [label="Mark new Overworld initialized\nconstruct remaining dimensions; install world-border listeners", fillcolor="#dbeafe"];
    prepare_levels [label="MinecraftServer.prepareLevels()\nactivate persisted tickets and wait for ticketed FULL chunks\nupdate mob-spawning flags and effective respawn data", fillcolor="#fef3c7"];

    biome_resolver -> initialized_world;
    initialized_world -> skip_spawn_init [label="yes"];
    initialized_world -> debug_spawn_check [label="no"];
    debug_spawn_check -> debug_spawn [label="yes"];
    debug_spawn_check -> spawn_origin [label="no"];
    spawn_origin -> spawn_height -> spawn_spiral -> spawn_full_request;
    final_spawn -> bonus_chest_check;
    bonus_chest_check -> bonus_chest [label="yes"];
    spawn_candidate -> final_spawn [label="yes"];
    spawn_candidate -> spawn_more [label="no"];
    spawn_more -> spawn_spiral [label="yes; next chunk"];
    spawn_more -> final_spawn [label="no; fallback"];
    bonus_chest_check -> finish_levels [label="no"];
    bonus_chest -> finish_levels;
    skip_spawn_init -> finish_levels;
    debug_spawn -> finish_levels;
    finish_levels -> prepare_levels;
  }

  subgraph cluster_scheduler {
    label="4. Chunk request, tickets, disk load, and generation scheduling";
    color="#fbbf24";
    fillcolor="#fffbeb";
    style="rounded,filled";

    request_sources [label="Chunk requested by spawn search, player view, commands,\nportal/gameplay access, or persisted ticket", fillcolor="#fef3c7"];
    status_request [label="ServerChunkCache.getChunk / getChunkFuture\ntarget ChunkStatus (commonly FULL)", fillcolor="#fef3c7"];
    add_ticket [label="Add loading ticket at target status level\nDistanceManager.runAllUpdates()", fillcolor="#fef3c7"];
    schedule_holder [label="GenerationChunkHolder.scheduleChunkGenerationTask()", fillcolor="#fef3c7"];
    generation_task [label="ChunkGenerationTask.create()\nreserve worst-case dependency cache\nFULL generation uses radius 11 = 23 x 23 chunks", fillcolor="#fef3c7"];
    empty_status [label="EMPTY\nChunkMap.scheduleChunkLoad()", fillcolor="#fef3c7"];
    region_data [shape=diamond, label="Valid chunk NBT exists?", fillcolor="#fee2e2"];
    deserialize [label="SerializableChunkData.parse/read\nrestore sections, palettes, biomes, heightmaps, structures,\nreferences, ticks, block entities, light, persisted status", fillcolor="#e2e8f0"];
    fresh_proto [label="Create fresh ProtoChunk\npersisted status = EMPTY", fillcolor="#fef3c7"];
    load_eligible [shape=diamond, label="Center and required neighbors already\nhave sufficient persisted statuses?", fillcolor="#fee2e2"];
    loading_pyramid [label="LOADING_PYRAMID\nreuse saved structures/biomes/terrain/features/spawn\nreinstall structure metadata, initialize/validate light, convert FULL", fillcolor="#e2e8f0"];
    generation_pyramid [label="Generation dependency layers\nper chunk/step: GENERATION_PYRAMID only above persisted status;\notherwise LOADING_PYRAMID (reuse completed work)", fillcolor="#fef3c7"];
    status_commit [label="After each successful ProtoChunk stage\nsetPersistedStatus(target) + mark unsaved", fillcolor="#fef3c7"];

    spawn_full_request -> status_request [ltail=cluster_spawn_init, lhead=cluster_scheduler];
    prepare_levels -> request_sources [style=dashed, label="ticketed chunks"];
    request_sources -> status_request -> add_ticket -> schedule_holder -> generation_task -> empty_status -> region_data;
    region_data -> deserialize [label="yes"];
    region_data -> fresh_proto [label="no / recoverable error"];
    deserialize -> load_eligible;
    fresh_proto -> load_eligible;
    load_eligible -> loading_pyramid [label="yes"];
    load_eligible -> generation_pyramid [label="no"];
  }

  subgraph cluster_dependencies {
    label="Generation-pyramid direct prerequisites (Chebyshev chunk distance)";
    color="#cbd5e1";
    fillcolor="#f1f5f9";
    style="rounded,filled";

    dependency_table [
      shape=record,
      style="filled",
      fillcolor="#ffffff",
      label="{Target status|Direct requirements|Accumulated maximum radius}|{STRUCTURE_STARTS|EMPTY at d0|0}|{STRUCTURE_REFERENCES|STRUCTURE_STARTS at d0..8|8}|{BIOMES|REFERENCES d0; STARTS d1..8|8}|{TERRAIN|BIOMES d0..1; STARTS d2..8|9}|{FEATURES|TERRAIN d0..1; STARTS d2..8|10}|{INITIALIZE_LIGHT|FEATURES d0|10}|{LIGHT|INITIALIZE_LIGHT d0..1|11}|{SPAWN|LIGHT d0; BIOMES d1|11}|{FULL|SPAWN d0|11}"
    ];
  }

  generation_pyramid -> dependency_table [style=dashed, label="scheduler enforces"];

  subgraph cluster_structures {
    label="5. STRUCTURE_STARTS and STRUCTURE_REFERENCES";
    color="#86efac";
    fillcolor="#f0fdf4";
    style="rounded,filled";

    structures_enabled [shape=diamond, label="generateStructures enabled?", fillcolor="#fee2e2"];
    structure_sets [label="For each possible StructureSet\ntest StructurePlacement.isStructureChunk(seed, chunk)", fillcolor="#dcfce7"];
    structure_select [label="Weighted structure selection\nlegacy/large-feature positional random", fillcolor="#dcfce7"];
    structure_generate [label="Structure.generate()\ncheck allowed biome, choose generation point, build piece list", fillcolor="#dcfce7"];
    structure_valid [shape=diamond, label="Valid StructureStart?", fillcolor="#fee2e2"];
    store_start [label="Store StructureStart\nbounding boxes, pieces, junctions, reference count", fillcolor="#dcfce7"];
    starts_available [label="ServerLevel.onStructureStartsAvailable()\nupdate StructureCheck", fillcolor="#dcfce7"];
    reference_scan [label="STRUCTURE_REFERENCES\nscan source chunks in radius 8 (17 x 17)", fillcolor="#dcfce7"];
    reference_intersect [label="For each valid start\nif start bounding box intersects target chunk footprint", fillcolor="#dcfce7"];
    store_reference [label="Store source chunk position in target's\nper-structure reference set", fillcolor="#dcfce7"];

    generation_pyramid -> structures_enabled [lhead=cluster_structures];
    structures_enabled -> structure_sets [label="yes"];
    structures_enabled -> starts_available [label="no"];
    structure_sets -> structure_select -> structure_generate -> structure_valid;
    structure_valid -> store_start [label="yes"];
    structure_valid -> structure_sets [label="no / next candidate"];
    store_start -> starts_available;
    structure_sets -> starts_available [label="all sets processed / none eligible"];
    starts_available -> status_commit [style=dotted, label="persist STARTS"];
    starts_available -> reference_scan -> reference_intersect -> store_reference;
    store_reference -> status_commit [style=dotted, label="persist REFERENCES"];
  }

  subgraph cluster_biomes {
    label="6. BIOMES";
    color="#86efac";
    fillcolor="#f0fdf4";
    style="rounded,filled";

    biome_density_pool [label="Acquire density-buffer pool\nRandomState.createClimateSampler()", fillcolor="#dcfce7"];
    biome_source_type [shape=diamond, label="BiomeSource.createResolverForChunk()\nWhich biome source?", fillcolor="#fee2e2"];
    biome_other [label="FixedBiomeSource: constant biome (flat/debug)\nCheckerboardColumnBiomeSource: X/Z checkerboard (custom)\nTheEndBiomeSource: central radius + erosion-based outer biomes", fillcolor="#dcfce7"];
    biome_climate [label="MultiNoiseBiomeSource (Overworld / Nether)\nsample six climate fields at quart coordinates\ntemperature, humidity, continentalness, erosion, depth, weirdness", fillcolor="#dcfce7"];
    biome_quantize [label="Quantize each float: (long)(value * 10000)\nform Climate.TargetPoint", fillcolor="#dcfce7"];
    biome_lookup [label="Climate.ParameterList.findValue()\nnearest 7-D parameter point including offset penalty", fillcolor="#dcfce7"];
    biome_blend [label="Decorate resolver for old/new blending\nand below-zero retrogen where applicable", fillcolor="#dcfce7"];
    biome_palette [label="ProtoChunk.fillBiomesFromNoise()\nwrite 4 x 4 x 4 biome palette cells per section", fillcolor="#dcfce7"];
    biome_release [label="Release density-buffer pool", fillcolor="#dcfce7"];

    biome_density_pool -> biome_source_type;
    biome_source_type -> biome_climate [label="multi-noise"];
    biome_source_type -> biome_other [label="other built-in sources"];
    biome_climate -> biome_quantize -> biome_lookup -> biome_blend -> biome_palette -> biome_release;
    biome_other -> biome_blend;
    biome_release -> status_commit [style=dotted, label="persist BIOMES"];
  }

  subgraph cluster_density_graph {
    label="7A. Overworld NoiseRouter and final-density graph";
    color="#4ade80";
    fillcolor="#ecfdf5";
    style="rounded,filled";

    noise_seed [label="World seed -> positional RNG factories -> keyed noises\nXoroshiro: MD5-derived identifiers; legacy: String.hashCode\nlegacy temperature/vegetation/base-noise special cases", fillcolor="#bbf7d0"];
    shift_noises [label="SHIFT_X / SHIFT_Z noises", fillcolor="#bbf7d0"];
    climate_noises [label="Shifted temperature, vegetation, continentalness, erosion\nplus ridge/weirdness", fillcolor="#bbf7d0"];
    terrain_splines [label="TerrainProvider cubic splines\ncontinentalness + erosion + ridges/weirdness", fillcolor="#bbf7d0"];
    offset_factor [label="offset + factor + jaggedness\ndepth = Y gradient + offset", fillcolor="#bbf7d0"];
    initial_density [label="noiseGradientDensity(factor, depth + jaggedness)", fillcolor="#bbf7d0"];
    sloped_cheese [label="sloped_cheese = initial density + base 3-D noise", fillcolor="#bbf7d0"];
    entrances [label="Surface branch: min(sloped_cheese, 5 * entrances)\nentrances = spaghetti 3-D + roughness + entrance noise", fillcolor="#bbf7d0"];
    underground [label="Underground caves\ncheese + layers + spaghetti 2-D + pillars", fillcolor="#bbf7d0"];
    cave_choice [label="Range-select surface entrances vs underground cave graph", fillcolor="#bbf7d0"];
    slide [label="Apply overworld top and bottom slides", fillcolor="#bbf7d0"];
    post_process_density [label="Blend density -> multiply 0.64\n4 x 8 interpolation -> squeeze", fillcolor="#bbf7d0"];
    noodle [label="Noodle cave density\ny-limited toggle + thickness + two ridges", fillcolor="#bbf7d0"];
    beard [label="Beardifier density from terrain-adapting structure pieces\nBURY / BEARD_THIN / BEARD_BOX / ENCAPSULATE", fillcolor="#bbf7d0"];
    final_density [label="final_density = min(post-processed caves, noodle) + beardifier", fillcolor="#86efac"];

    random_state -> noise_seed [style=dashed];
    noise_seed -> shift_noises -> climate_noises -> terrain_splines -> offset_factor -> initial_density -> sloped_cheese;
    sloped_cheese -> entrances -> cave_choice;
    sloped_cheese -> underground -> cave_choice;
    cave_choice -> slide -> post_process_density -> final_density;
    noodle -> final_density;
    beard -> final_density;
  }

  subgraph cluster_terrain {
    label="7B. TERRAIN: density fill, aquifers, materials, and carvers";
    color="#4ade80";
    fillcolor="#f0fdf4";
    style="rounded,filled";

    collect_biomes [label="Collect possible biome palette entries\nfrom center 3 x 3 terrain neighborhood", fillcolor="#dcfce7"];
    create_blender [label="Blender.of(WorldGenRegion)\nempty for new world; old/new height, density, biome and carving blend for upgrades", fillcolor="#dcfce7"];
    create_beardifier [label="Beardifier.forStructuresInChunk()\nresolve referenced terrain-adapting starts\ncollect nearby rigid pieces and jigsaw junctions", fillcolor="#dcfce7"];
    create_noise_chunk [label="Create NoiseChunk\nDensityVolume + sampler caches + buffer pool + blender + beardifier", fillcolor="#dcfce7"];
    create_aquifer [label="Create enabled Aquifer\nbarrier, floodedness, spread, lava, exclusion, preliminary surface\nor disabled global-fluid picker", fillcolor="#dcfce7"];
    terrain_generator_path [shape=diamond, label="Generator terrain implementation?", fillcolor="#fee2e2"];
    sample_volume [label="Sample final_density over 16 x generationHeight x 16 volume\ncompiled float samplers preserve cache/interpolation order", fillcolor="#dcfce7"];
    other_density [label="Nether / End / custom NoiseRouter\nuse configured density graph, interpolation, aquifers,\ndefault block/fluid and generation height", fillcolor="#dcfce7"];
    fill_loop [label="For z 0..15, x 0..15, y top..bottom", fillcolor="#dcfce7"];
    aquifer_substance [label="Aquifer.computeSubstance(x,y,z,density)\nnull -> generator default block (solid / pressure barrier)\notherwise returned air / water / lava", fillcolor="#dcfce7"];
    write_base [label="Write non-air block\nupdate OCEAN_FLOOR_WG + WORLD_SURFACE_WG\nmark fluid post-processing when required", fillcolor="#dcfce7"];

    material_context [label="MaterialSystem.buildSurface()\ncompile material rule and create per-column context", fillcolor="#dcfce7"];
    surface_columns [label="Scan each 16 x 16 column top-down\ntrack water, stone depth, surface depth, gradients, biome, temperature", fillcolor="#dcfce7"];
    material_dispatch [shape=diamond, label="Configured material rule?\nSequence rules use first matching result per block", fillcolor="#fee2e2"];
    other_material [label="Nether / End / custom material rules\nuse their own bedrock, surface and underground sequence", fillcolor="#dcfce7"];
    bedrock_rule [label="Normal Overworld priority 1: bedrock floor", fillcolor="#dcfce7"];
    copper_rule [label="2. Copper ore-vein material rule", fillcolor="#dcfce7"];
    iron_rule [label="3. Iron ore-vein material rule", fillcolor="#dcfce7"];
    surface_rule [label="4. Above preliminary surface\nbiome-specific grass/dirt/sand/gravel/terracotta/snow/ice/etc.\nplus badlands and frozen-ocean extensions", fillcolor="#dcfce7"];
    underground_rule [label="5. Underground sulfur/deepslate rules", fillcolor="#dcfce7"];

    carver_scan [label="For every source chunk in radius 8 (17 x 17)\nresolve source biome's cave carvers", fillcolor="#dcfce7"];
    carver_seed [label="For each carver index\nWorldgenRandom(LegacyRandomSource)\nsetLargeFeatureSeed(seed + index, sourceX, sourceZ)", fillcolor="#dcfce7"];
    carver_start [shape=diamond, label="WorldCarver.isStartChunk()?", fillcolor="#fee2e2"];
    carver_geometry [label="Cave / extra-underground cave / canyon\nwrite requested geometry into CarvingMask", fillcolor="#dcfce7"];
    apply_mask [label="Visit carving-mask vertical runs top-down\napply blender filter; skip UNCARVABLE blocks", fillcolor="#dcfce7"];
    carved_substance [label="Aquifer.computeSubstance(..., density=0)\nnon-null: place air / water / lava; null: retain block\nrepair dirt exposed below grass/mycelium using topMaterial", fillcolor="#dcfce7"];
    retrogen [label="If BelowZeroRetrogen\nreplace old bedrock + apply recorded bedrock-hole mask", fillcolor="#e2e8f0"];
    prime_heightmaps [label="Prime final heightmaps\nWORLD_SURFACE, OCEAN_FLOOR, MOTION_BLOCKING,\nMOTION_BLOCKING_NO_LEAVES", fillcolor="#dcfce7"];
    terrain_alternatives [label="Alternative generators\nflat: fill configured layers\ndebug: TERRAIN is a no-op", fillcolor="#e2e8f0"];

    biome_release -> terrain_generator_path [lhead=cluster_terrain];
    terrain_generator_path -> collect_biomes [label="noise"];
    terrain_generator_path -> terrain_alternatives [label="flat/debug"];
    collect_biomes -> create_blender -> create_beardifier -> create_noise_chunk -> create_aquifer -> sample_volume;
    final_density -> sample_volume [style=dashed, label="Overworld settings"];
    random_state -> other_density [style=dashed];
    other_density -> sample_volume [style=dashed, label="other noise settings"];
    sample_volume -> fill_loop -> aquifer_substance -> write_base -> material_context -> surface_columns;
    surface_columns -> material_dispatch;
    material_dispatch -> bedrock_rule [label="normal Overworld"];
    material_dispatch -> other_material [label="other settings"];
    bedrock_rule -> copper_rule -> iron_rule -> surface_rule -> underground_rule [label="if no match"];
    material_dispatch -> carver_scan [label="material pass complete"];
    carver_scan -> carver_seed -> carver_start;
    carver_start -> carver_geometry [label="yes"];
    carver_start -> carver_scan [label="no / next"];
    carver_geometry -> carver_scan [label="next carver/source"];
    carver_scan -> apply_mask [label="all sources complete"];
    apply_mask -> carved_substance -> retrogen -> prime_heightmaps;
    prime_heightmaps -> status_commit [style=dotted, label="persist TERRAIN"];
    flat_generator -> terrain_alternatives [style=dashed];
    debug_generator -> terrain_alternatives [style=dashed];
    terrain_alternatives -> prime_heightmaps [style=dashed];
  }

  subgraph cluster_features {
    label="8. FEATURES: structure blocks and biome decoration";
    color="#4ade80";
    fillcolor="#f0fdf4";
    style="rounded,filled";

    feature_prepare [label="WorldGenRegion with block-write radius 1\ncenter + eight neighbors may be modified", fillcolor="#dcfce7"];
    feature_generator_path [shape=diamond, label="Decoration implementation / debug flags?", fillcolor="#fee2e2"];
    debug_features [label="DebugLevelSource.applyBiomeDecoration()\nbarrier plane at Y=60 + block-state display grid at Y=70", fillcolor="#e2e8f0"];
    feature_sorter [label="FeatureSorter precomputes stable per-step ordering\nfrom every possible biome; rejects dependency cycles", fillcolor="#dcfce7"];
    decoration_seed [label="setDecorationSeed(worldSeed, chunk min X, chunk min Z)\ncollect actual biome palette entries from center 3 x 3", fillcolor="#dcfce7"];
    decoration_stages [
      shape=record,
      style="filled",
      fillcolor="#dcfce7",
      label="{Decoration stages in exact ordinal order|0 RAW_GENERATION|1 LAKES|2 LOCAL_MODIFICATIONS|3 UNDERGROUND_STRUCTURES|4 SURFACE_STRUCTURES|5 STRONGHOLDS|6 UNDERGROUND_ORES|7 UNDERGROUND_DECORATION|8 FLUID_SPRINGS|9 VEGETAL_DECORATION|10 TOP_LAYER_MODIFICATION}"
    ];
    each_stage [label="For each decoration stage\nstructures first, then placed features", fillcolor="#dcfce7"];
    stage_structures [shape=diamond, label="Structures enabled?", fillcolor="#fee2e2"];
    structure_feature_seed [label="For each registered structure in this stage\nsetFeatureSeed(decorationSeed, structureIndex, stageIndex)", fillcolor="#dcfce7"];
    resolve_starts [label="Resolve center chunk's referenced valid starts", fillcolor="#dcfce7"];
    place_pieces [label="StructureStart.placeInChunk()\npostProcess intersecting pieces in stored order\nthen Structure.afterPlace()", fillcolor="#dcfce7"];
    collect_features [label="Union this stage's PlacedFeatures from actual nearby biomes\nmap by FeatureSorter identity index + sort ascending", fillcolor="#dcfce7"];
    placed_feature_seed [label="For each selected feature index\nsetFeatureSeed(decorationSeed, featureIndex, stageIndex)", fillcolor="#dcfce7"];
    modifiers [label="FeaturePlacer\ndepth-first placement-modifier chain\nfilters, count, square, height range/map, biome, offsets, scans", fillcolor="#dcfce7"];
    feature_place [label="Feature.place() at every terminal position\nmay invoke nested PlacedFeatures with the same random stream", fillcolor="#dcfce7"];
    neighbor_writes [label="WorldGenRegion.setBlock()\nupdate chunk sections/heightmaps/POI/block entities\nqueue shape/fluid post-processing", fillcolor="#dcfce7"];
    next_stage [shape=diamond, label="More decoration stages?", fillcolor="#fee2e2"];
    blending_ticks [label="Blender.generateBorderTicks()\nmark leaves/fluids at old-new generation borders", fillcolor="#dcfce7"];

    prime_heightmaps -> feature_generator_path [lhead=cluster_features];
    feature_generator_path -> feature_prepare [label="normal"];
    feature_generator_path -> debug_features [label="debug generator"];
    feature_generator_path -> blending_ticks [label="features globally disabled"];
    debug_features -> blending_ticks;
    feature_prepare -> feature_sorter -> decoration_seed -> decoration_stages -> each_stage -> stage_structures;
    stage_structures -> structure_feature_seed [label="yes"];
    structure_feature_seed -> resolve_starts -> place_pieces -> collect_features;
    stage_structures -> collect_features [label="no"];
    collect_features -> placed_feature_seed -> modifiers -> feature_place -> neighbor_writes -> next_stage;
    collect_features -> next_stage [label="no features in this stage"];
    modifiers -> next_stage [label="all placements rejected / feature loop complete"];
    neighbor_writes -> placed_feature_seed [label="next feature, if any"];
    next_stage -> each_stage [label="yes"];
    next_stage -> blending_ticks [label="no"];
    blending_ticks -> status_commit [style=dotted, label="persist FEATURES"];
  }

  subgraph cluster_light_spawn_full {
    label="9. INITIALIZE_LIGHT, LIGHT, SPAWN, and generation FULL";
    color="#fbbf24";
    fillcolor="#fffbeb";
    style="rounded,filled";

    initialize_light [label="INITIALIZE_LIGHT\nrebuild skylight sources; attach ThreadedLevelLightEngine\nmark non-air sections; retain valid saved light when possible", fillcolor="#fef3c7"];
    light [label="LIGHT\nset lightCorrect=false\npropagate sky/block sources and run queued updates\nset lightCorrect=true", fillcolor="#fef3c7"];
    spawn_needed [shape=diamond, label="SPAWN missing from persisted status?", fillcolor="#fee2e2"];
    spawn_status [label="Generate SPAWN\nnoise generator only, unless retrogen or mob generation disabled:\nNaturalSpawner.spawnMobsForChunkGeneration()\nflat/debug: no original-mob generation", fillcolor="#fef3c7"];
    full_branch [shape=diamond, label="FULL input type?", fillcolor="#fee2e2"];
    unwrap_full [label="Persisted full chunk\nunwrap ImposterProtoChunk -> existing LevelChunk", fillcolor="#e2e8f0"];
    convert_full [label="Generated chunk\nProtoChunk -> LevelChunk\ntransfer sections, heightmaps, structures, ticks, block entities", fillcolor="#fef3c7"];
    activate_level_chunk [label="Activate LevelChunk\nset full-status supplier; run post-load; loaded=true\nregister block entities, event listeners, tickers, tick containers\ninstall unsaved listener", fillcolor="#fef3c7"];
    generation_full [label="ChunkStatus.FULL future complete", fillcolor="#fde68a"];

    blending_ticks -> initialize_light [label="next status"];
    initialize_light -> status_commit [style=dotted, label="persist INITIALIZE_LIGHT"];
    initialize_light -> light;
    light -> status_commit [style=dotted, label="persist LIGHT"];
    light -> spawn_needed;
    spawn_needed -> spawn_status [label="yes"];
    spawn_needed -> full_branch [label="no; loading SPAWN is pass-through"];
    spawn_status -> status_commit [style=dotted, label="persist SPAWN"];
    spawn_status -> full_branch;
    loading_pyramid -> initialize_light [style=dashed, label="loaded light path"];
    full_branch -> unwrap_full [label="ImposterProtoChunk"];
    full_branch -> convert_full [label="ProtoChunk"];
    unwrap_full -> activate_level_chunk;
    convert_full -> activate_level_chunk -> generation_full;
    generation_full -> spawn_candidate [style=dashed, label="global spawn search resumes"];
  }

  subgraph cluster_runtime {
    label="10. Ticket-driven runtime promotion and active gameplay";
    color="#c4b5fd";
    fillcolor="#f5f3ff";
    style="rounded,filled";

    holder_update [label="Ticket level changes\nChunkHolder.updateHighestAllowedStatus() + updateFutures()", fillcolor="#ede9fe"];
    accessible [label="FullChunkStatus.FULL (ticket level 33)\nprepareAccessibleChunk: center FULL + radius-1 status dependencies\nruntime-accessible chunk; entity storage becomes TRACKED", fillcolor="#ede9fe"];
    ticking_ready [label="prepareTickingChunk() requires 3 x 3 FULL neighborhood", fillcolor="#ede9fe"];
    postprocess_generation [label="LevelChunk.postProcessGeneration()\nrun deferred fluid/block neighbor-shape updates\npromote pending block entities + apply upgrade data", fillcolor="#ede9fe"];
    unpack_ticks [label="ServerLevel.startTickingChunk()\nunpack saved block/fluid ticks to absolute times", fillcolor="#ede9fe"];
    block_ticking [label="FullChunkStatus.BLOCK_TICKING (ticket level 32)\nchunk eligible for initial transmission and block simulation", fillcolor="#ddd6fe"];
    entity_ready [label="prepareEntityTickingChunk() requires 5 x 5 FULL neighborhood", fillcolor="#ede9fe"];
    entity_ticking [label="FullChunkStatus.ENTITY_TICKING (ticket level <= 31)\nentity manager visibility = TICKING", fillcolor="#ddd6fe"];
    entity_load [label="Load modern entities from entities region files\nstart tracking -> ChunkMap.TrackedEntity\nstart ticking -> EntityTickList", fillcolor="#ede9fe"];
    simulation_gate [label="Actual entity, block, and scheduled ticks\nalso gated by simulation distance and game rules", fillcolor="#ede9fe"];
    playable_server [label="Authoritative server world is playable\nblocks, fluids, block entities, entities, scheduled ticks", fillcolor="#ddd6fe"];

    generation_full -> holder_update [lhead=cluster_runtime];
    holder_update -> accessible;
    holder_update -> ticking_ready -> postprocess_generation -> unpack_ticks -> block_ticking;
    holder_update -> entity_ready -> entity_ticking;
    accessible -> entity_load;
    entity_ticking -> entity_load -> simulation_gate -> playable_server;
    block_ticking -> playable_server;
  }

  subgraph cluster_save {
    label="11. Parallel persistence path";
    color="#cbd5e1";
    fillcolor="#f1f5f9";
    style="rounded,filled";

    mark_unsaved [label="Chunk mutations mark chunk unsaved\nunsaved listener queues eager save", fillcolor="#e2e8f0"];
    save_trigger [label="Periodic eager save, save-all, or unload", fillcolor="#e2e8f0"];
    save_snapshot [label="SerializableChunkData.copyOf()\nsnapshot status, sections, light, heightmaps, structures,\nblock entities, post-processing, and ticks", fillcolor="#e2e8f0"];
    save_nbt [label="SerializableChunkData.write() -> NBT", fillcolor="#e2e8f0"];
    io_worker [label="IOWorker coalesces asynchronous pending writes", fillcolor="#e2e8f0"];
    region_write [label="RegionFileStorage / RegionFile\ncompress + allocate sectors + update header/timestamp\nregion/r.x.z.mca", fillcolor="#e2e8f0"];
    entity_save [label="Modern entities saved separately\nentities/r.x.z.mca", fillcolor="#e2e8f0"];
    world_save [label="World metadata and saved data\nlevel.dat, data/minecraft/world_gen_settings.dat, tickets, etc.\nplayerdata/<uuid>.dat; POI in poi/r.x.z.mca", fillcolor="#e2e8f0"];

    convert_full -> mark_unsaved [style=dashed];
    status_commit -> mark_unsaved [style=dashed];
    mark_unsaved -> save_trigger -> save_snapshot -> save_nbt -> io_worker -> region_write;
    entity_load -> entity_save [style=dashed];
    save_trigger -> world_save [style=dashed, label="world/player save lifecycle"];
  }

  subgraph cluster_network {
    label="12. Player tracking and server-to-client chunk delivery";
    color="#c4b5fd";
    fillcolor="#f5f3ff";
    style="rounded,filled";

    connection_start [label="Client connects to ready server\nsingleplayer: local in-memory connection\nmultiplayer: remote connection + login/authentication as configured", fillcolor="#ede9fe"];
    configure_client [label="Configuration protocol\nsynchronize enabled features, registries/tags and known packs\noptional server resource pack / code of conduct tasks", fillcolor="#ede9fe"];
    prepare_player [label="PrepareSpawnTask\nload player data: saved dimension/position/rotation, or\nPlayerSpawnFinder.findSpawn near global spawn\nrespawn radius + border + collision/liquid checks", fillcolor="#ede9fe"];
    player_spawn_ticket [label="PLAYER_SPAWN ticket: radius 3\naddTicketAndLoadWithRadius(); wait for chunk future", fillcolor="#ede9fe"];
    join_world [label="JoinWorldTask / finish-configuration acknowledgement\nwaitForEntities(spawnChunk, 3); create ServerPlayer\nload saved state, snap to chosen position\nPlayerList.placeNewPlayer()", fillcolor="#ede9fe"];
    login_play [label="Send play Login + abilities/inventory/world state\ninitial position teleport; add player to ServerLevel\nLEVEL_CHUNKS_LOAD_START game event", fillcolor="#ede9fe"];
    client_level_init [label="ClientPacketListener.handleLogin()\ncreate ClientLevel + LocalPlayer + game mode\nstart LevelLoadTracker / loading screen\napply initial teleport and send AcceptTeleportation", fillcolor="#ede9fe"];
    player_view [label="Player joins/moves or view distance changes\nChunkMap.updateChunkTracking() + distance-manager player tracking", fillcolor="#ede9fe"];
    tracking_diff [label="ChunkTrackingView.difference()\nnewly entered and exited chunks", fillcolor="#ede9fe"];
    pending_send [label="When BLOCK_TICKING/send-sync ready\nPlayerChunkSender.pendingChunks", fillcolor="#ede9fe"];
    send_batch [label="Per server tick: sendNextChunks()\nquota/backpressure + nearest pending chunks\nChunkBatchStart", fillcolor="#ede9fe"];
    chunk_packet [label="ClientboundLevelChunkWithLightPacket", fillcolor="#ddd6fe"];
    chunk_payload [label="Chunk payload\nheightmaps + every section's block/biome palettes\nblock-entity update tags", fillcolor="#ede9fe"];
    light_payload [label="Light payload\nsky/block masks + empty masks + 2048-byte DataLayers", fillcolor="#ede9fe"];
    packet_encode [label="Connection sends packets\nremote: STREAM_CODEC -> PacketEncoder -> Netty bytes\nlocal memory connection: packet objects bypass byte codecs", fillcolor="#ede9fe"];
    entity_packets [label="Tracked entities sent separately\nspawn + metadata + attributes + equipment + passengers", fillcolor="#ede9fe"];
    batch_finished [label="ChunkBatchFinished(count) after batch\nclient ChunkBatchSizeCalculator measures receive time\nServerboundChunkBatchReceivedPacket(desiredChunksPerTick)", fillcolor="#ede9fe"];
    forget_chunk [label="Exited view: cancel pending send or send ForgetLevelChunk\nclient drops chunk, light and render-section state", fillcolor="#ede9fe"];

    prepare_levels -> connection_start;
    connection_start -> configure_client -> prepare_player -> player_spawn_ticket;
    prepare_player -> request_sources [style=dashed, label="SPAWN_SEARCH tickets when needed"];
    player_spawn_ticket -> request_sources [style=dashed, label="load surrounding chunks"];
    player_spawn_ticket -> join_world [label="spawn chunks ready"];
    join_world -> login_play;
    login_play -> client_level_init;
    login_play -> player_view;
    player_view -> request_sources [style=dashed, label="player tickets drive generation"];
    player_view -> tracking_diff;
    tracking_diff -> pending_send [label="entered view; once send-ready"];
    tracking_diff -> forget_chunk [label="exited view"];
    block_ticking -> pending_send [label="onChunkReadyToSend"];
    pending_send -> send_batch -> chunk_packet;
    chunk_packet -> chunk_payload -> packet_encode;
    chunk_packet -> light_payload -> packet_encode;
    entity_load -> entity_packets -> packet_encode;
    send_batch -> batch_finished [label="after all chunk packets"];
    batch_finished -> send_batch [style=dashed, label="ack releases backpressure / adjusts quota"];
  }

  subgraph cluster_client {
    label="13. Client decode, light installation, meshing, GPU upload, and rendering";
    color="#c4b5fd";
    fillcolor="#f5f3ff";
    style="rounded,filled";

    packet_decode [label="Remote PacketDecoder (local: packet object)\nClientPacketListener.handleLevelChunkWithLight() on client thread", fillcolor="#ede9fe"];
    client_cache [label="ClientChunkCache.replaceWithPacketData()\ncreate or replace client LevelChunk", fillcolor="#ede9fe"];
    read_sections [label="Read block-state and biome palettes into sections\ninstall heightmaps and initialize light-source metadata", fillcolor="#ede9fe"];
    client_block_entities [label="Create client block entities\napply update tags + install client tickers", fillcolor="#ede9fe"];
    install_light [label="Queue and apply sky/block DataLayers\nenable chunk light + update section emptiness", fillcolor="#ede9fe"];
    mark_dirty [label="Mark chunk and neighboring sections dirty", fillcolor="#ede9fe"];
    visibility [label="LevelExtractor + SectionOcclusionGraph\nloaded/empty sets, occlusion propagation, frustum-visible sections", fillcolor="#ede9fe"];
    neighbor_gate [shape=diamond, label="Initial section mesh has all 8 horizontal\nneighbor columns and light enabled?", fillcolor="#fee2e2"];
    region_snapshot [label="RenderRegionCache\ncopy 3 x 3 x 3 section neighborhood", fillcolor="#ede9fe"];
    cpu_mesh [label="SectionCompiler scans 16 x 16 x 16 blocks\nmodel/fluid tessellation by render layer\nvisibility graph + translucent sorting", fillcolor="#ede9fe"];
    mesh_data [label="Build vertex/index MeshData\nopaque, cutout, translucent layers", fillcolor="#ede9fe"];
    gpu_stage [label="Stage allocations in UberGpuBuffers", fillcolor="#ede9fe"];
    gpu_upload [label="Render thread uploads terrain buffers to GPU\npublish CompiledSectionMesh after all uploads finish", fillcolor="#ede9fe"];
    draw_prepare [label="Frustum/occlusion select visible compiled sections\nprepare direct or multidraw-indirect commands", fillcolor="#ede9fe"];
    draw [label="Opaque and translucent render passes\ndrawMultipleIndexed / drawIndexedIndirect", fillcolor="#ddd6fe"];
    client_ready [label="LevelLoadTracker: LEVEL_CHUNKS_LOAD_START received\nwait for camera section compiled and visible (including fade)\nbypass for spectator/dead/outside build height, or 30 s timeout\nthen configured close delay", fillcolor="#ede9fe"];
    player_loaded [label="Close loading screen; send ServerboundPlayerLoadedPacket\nserver marks client-loaded state\n(server also has a 60-tick loaded-state timeout)", fillcolor="#ede9fe"];
    live_updates [label="Ongoing gameplay loop\nclient movement/actions -> authoritative server simulation\nblock/section/light/block-entity/entity update packets\nclient applies updates and remeshes dirty sections", fillcolor="#ede9fe"];
    player_world [label="FINISHED PLAYER EXPERIENCE\nterrain visible; lighting active; entities arrive separately;\nclient input drives interaction against authoritative server", fillcolor="#c4b5fd", penwidth=2.0];

    packet_encode -> packet_decode [lhead=cluster_client];
    client_level_init -> client_cache [style=dashed, label="client world must exist first"];
    packet_decode -> client_cache -> read_sections -> client_block_entities -> install_light -> mark_dirty -> visibility -> neighbor_gate;
    neighbor_gate -> region_snapshot [label="yes"];
    neighbor_gate -> mark_dirty [label="no; wait for neighbor/light"];
    region_snapshot -> cpu_mesh -> mesh_data -> gpu_stage -> gpu_upload -> draw_prepare -> draw -> player_world;
    client_level_init -> client_ready;
    gpu_upload -> client_ready [style=dashed, label="player-section compiled callback via renderer"];
    client_ready -> player_loaded -> player_world;
    player_world -> live_updates;
    live_updates -> mark_dirty [style=dashed, label="changed terrain/light"];
    live_updates -> player_view [style=dashed, label="movement / dimension travel"];
    entity_packets -> player_world [style=dashed, label="entity visibility"];
    playable_server -> player_world [style=dashed, label="gameplay authority"];
  }

  subgraph cluster_notes {
    label="Scope and interpretation";
    color="#94a3b8";
    fillcolor="#ffffff";
    style="rounded,dashed";

    notes [
      shape=note,
      style="filled",
      fillcolor="#ffffff",
      label="Source-audited against the supplied mc-26.3-source decompilation.\nEnd-to-end successful lifecycle, with algorithm details focused on vanilla normal Overworld.\nOther noise settings and biome sources, flat/debug, and saved-chunk reuse branch explicitly.\nArrows show flow/data dependencies, not one synchronous call stack; dashed arrows link parallel systems.\nRule/noise subgraphs describe evaluation dependencies or priority, not unconditional block overwrites.\nStatus stages run only as needed; a request may stop before FULL. Empty loops still complete their stage.\nGeneration is demand/ticket driven, never the entire infinite world up front.\nFULL generation, runtime promotion, persistence, delivery, rendering and player-loaded are separate milestones.\nErrors/cancellation, every feature's internals, and every render pass are outside this lifecycle overview."
    ];
  }

  store_reference -> biome_density_pool [lhead=cluster_biomes];
  player_world -> notes [style=dotted, arrowhead=none];
}

